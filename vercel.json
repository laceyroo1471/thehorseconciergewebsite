{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/providers/:slug", "destination": "/api/providers/:slug" }
  ],
  "redirects": [
    { "source": "/horsemanship-challenge-week-04", "destination": "/horsemanship-challenge-week-04-ride", "permanent": true },
    { "source": "/horsemanship-challenge-week-07", "destination": "/horsemanship-challenge-week-07-ride", "permanent": true },
    { "source": "/horsemanship-challenge-week-08-emergency", "destination": "/horsemanship-challenge-week-11-emergency", "permanent": true },
    { "source": "/horsemanship-challenge-week-11", "destination": "/horsemanship-challenge-week-11-emergency", "permanent": true },
    { "source": "/horsemanship-challenge-week-12-equine-behavior", "destination": "/horsemanship-challenge-week-08-equine-behavior", "permanent": true }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "lib/**"
    }
  },
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/horsemanship-challenge-hub",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/horsemanship-challenge-trailer-safety",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/horsemanship-challenge-week-(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
